---
import ProjectCard from './ProjectCard.astro';
import { projectList } from '../data/projects.js';

// Get all unique tags for filtering
const allTags = [...new Set(projectList.flatMap(project => project.tags || []))].sort();
---

<div id="container">
  <div class="search-filter-wrapper">
    <div class="inputContainer">
      <span class="input-icon">🔍</span>
      <input
        id="search"
        type="text"
        name="search"
        placeholder="Search projects..."
        aria-label="Search"
      />
    </div>
    <div class="inputContainer">
      <span class="input-icon">🏷️</span>
      <select id="tag-selector" aria-label="Filter by tags">
        <option value="">All Tags</option>
        {allTags.map(tag => (
          <option value={tag.toLowerCase()}>{tag}</option>
        ))}
      </select>
    </div>
  </div>
  <div id="results-count" class="results-count"></div>
</div>

<section id="project-list" class="containerLayout">
  {projectList.map((item) => (
    <ProjectCard
      name={item.name}
      logoLink={item.imageSrc}
      projectLink={item.projectLink}
      description={item.description}
      tags={item.tags}
      loadIssues={item.loadIssues}
    />
  ))}
</section>

<script>
  const projectCards = Array.from(document.querySelectorAll('.Card-Container')).map(card => {
    const title = card.querySelector('.Card-Title');
    const description = card.querySelector('.Card-Description p');
    const tags = Array.from(card.querySelectorAll('.Card-Tag p')).map(tag => tag.textContent || '');

    return {
      name: title?.textContent || '',
      description: description?.textContent || '',
      tags,
      element: card as HTMLElement,
    };
  });

  let searchValue = '';
  let selectedTag = '';

  const searchInput = document.getElementById('search') as HTMLInputElement;
  const tagSelector = document.getElementById('tag-selector') as HTMLSelectElement;
  const resultsCount = document.getElementById('results-count') as HTMLDivElement;

  function filterProjects() {
    let visibleCount = 0;

    projectCards.forEach(project => {
      const matchesSearch = !searchValue.trim() ||
        project.name.toLowerCase().includes(searchValue.toLowerCase()) ||
        project.description.toLowerCase().includes(searchValue.toLowerCase()) ||
        project.tags.some(tag => tag.toLowerCase().includes(searchValue.toLowerCase()));

      const matchesTag = !selectedTag ||
        project.tags.some(tag => tag.toLowerCase() === selectedTag);

      const isVisible = matchesSearch && matchesTag;
      project.element.style.display = isVisible ? 'block' : 'none';

      if (isVisible) visibleCount++;
    });

    // Update results count
    if (searchValue || selectedTag) {
      resultsCount.textContent = `Showing ${visibleCount} of ${projectCards.length} projects`;
      resultsCount.style.display = 'block';
    } else {
      resultsCount.style.display = 'none';
    }
  }

  searchInput.addEventListener('input', (e) => {
    searchValue = (e.target as HTMLInputElement).value;
    filterProjects();
  });

  tagSelector.addEventListener('change', (e) => {
    selectedTag = (e.target as HTMLSelectElement).value;
    filterProjects();
  });

  filterProjects();
</script>

<style>
  #container {
    max-width: 800px;
    margin: 2rem auto 1rem;
    padding: 0 1.5rem;
  }

  .search-filter-wrapper {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .inputContainer {
    flex: 1;
    min-width: 220px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 1rem;
    font-size: 1rem;
    pointer-events: none;
    z-index: 1;
  }

  #search,
  #tag-selector {
    width: 100%;
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    color: white;
    font-size: 0.95rem;
    backdrop-filter: blur(10px);
    transition: all 0.25s ease;
    appearance: none;
    -webkit-appearance: none;
  }

  #search::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  #search:focus,
  #tag-selector:focus {
    outline: none;
    border-color: rgba(96, 165, 250, 0.5);
    background: rgba(255, 255, 255, 0.09);
    box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
  }

  #tag-selector option {
    background: #1a1a2e;
    color: white;
  }

  .results-count {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
    display: none;
  }

  .containerLayout {
    columns: 3;
    column-gap: 1.5rem;
    padding: 2rem 1.5rem;
    break-inside: avoid;
  }

  @media (max-width: 1024px) {
    .containerLayout {
      columns: 2;
    }
  }

  @media (max-width: 768px) {
    #container {
      padding: 0 1rem;
      margin: 1.5rem auto 0.5rem;
    }

    .search-filter-wrapper {
      flex-direction: column;
      gap: 0.75rem;
    }

    .inputContainer {
      min-width: unset;
    }

    .containerLayout {
      columns: 1;
      padding: 1rem 1rem;
    }
  }
</style>